# 服务端口
PORT=8801

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=medai

# JWT 密钥（生产环境务必替换为随机字符串）
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=12h

# DeepSeek（留空则自动使用内置规则引擎，功能不受影响）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
